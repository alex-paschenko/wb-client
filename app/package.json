{
  "name": "whitebit-bot",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "profiling": "concurrently \"npm run dev:server:prof\" \"npm run dev:client\"",
    "dev:server": "node --import tsx src/server/index.ts",
    "dev:server:watch": "tsx watch src/server/index.ts",
    "dev:server:prof": "node --import tsx --watch --inspect=0.0.0.0:9229 --cpu-prof --cpu-prof-dir=. src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "research:market-phase": "node --import tsx src/server/research/market-phase-analysis.ts",
    "research:market-phase-online": "node --import tsx src/server/research/market-phase-online-analysis.ts",
    "research:market-phase-normalized-acceleration": "node --import tsx src/server/research/market-phase-normalized-acceleration.ts",
    "research:market-phase-online-oos": "node --import tsx src/server/research/market-phase-online-oos-analysis.ts",
    "research:market-phase-forecast": "node --import tsx src/server/research/market-phase-forecast-analysis.ts",
    "research:market-forecast-reliability": "node --import tsx src/server/research/market-forecast-reliability-analysis.ts",
    "research:simple-trading-emulate": "node --import tsx src/server/research/market-forecast-strategy-analysis.ts",
    "build": "tsc --noEmit",
    "migrate:create": "node-pg-migrate create --migrations-dir src/server/db/migrations --migration-file-language ts",
    "migrate:up": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate up --migrations-dir src/server/db/migrations --database-url \"$DATABASE_URL\"",
    "migrate:down": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate down --migrations-dir src/server/db/migrations --database-url \"$DATABASE_URL\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.3.0",
    "lightweight-charts": "^5.2.0",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3"
  }
}
